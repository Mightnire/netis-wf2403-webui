#mount none /proc -t proc
#mount tmpfs /var -t tmpfs

mount -t tmpfs -o size=16m tmpfs /var
mount -t proc proc proc
mount -t sysfs sysfs /sys
mount -t devpts devpts /dev/pts

DIRS=" ppp/peers udhcpc udhcpd dnrd run lib/misc linuxigd tmp log net-snmp system sys"

for dir in $DIRS ; do
	mkdir -p /var/$dir
done

insmod /lib/modules/ctf.ko
#eth0 module
insmod /lib/modules/et.ko
#insmod /lib/modules/bcm57xx.ko
