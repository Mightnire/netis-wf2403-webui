mount -t proc proc /proc
mount -t ramfs ramfs  /var
mount -t ramfs ramfs /tmp
mount -t usbfs usbfs /proc/bus/usb

ifconfig lo   127.0.0.1
route add -net 127.0.0.0 netmask 255.255.255.0 lo

DIRS="ppp/peers /ppp/plugins udhcpc udhcpd dnrd run lib/misc tmp log net-snmp system wireless wireless/RT2860 sys media"

for dir in $DIRS ; do
        mkdir -p /var/$dir
done

mkdir -p /var/dns
mkdir -p /var/cmd
mkdir -p /var/args

cp /etc/linuxigd/gatedesc.xml.ralink /var/gatedesc.xml

cp /usr/share/linuxigd /var -rf
echo > /var/rtxhw
flash default-hw

/bin/upnp.sh

ln -s /web /var/web

cp /etc/libplugin.a /var/ppp/plugins
cp /web/version.txt /tmp/version

echo "" > /etc/ppp/peers/rpptp
#cp /bin/pppoe.sh /var/udhcpc/eth0.deconfig
echo "" > /var/udhcpc/eth0.deconfig
#cp /bin/pppoe.sh /var/udhcpc/eth2.2.deconfig
echo "" > /var/udhcpc/eth2.2.deconfig
#cp /bin/pppoe.sh /var/udhcpc/br0.deconfig
echo "" > /var/udhcpc/br0.deconfig
#cp /bin/pppoe.sh /var/udhcpc/wlan0.deconfig
echo "" > /var/udhcpc/wlan0.deconfig
chmod 755 /var/udhcpc/*.deconfig

flash ralink
modeswitch
ifconfig eth2 up
vconfig add eth2 1
vconfig add eth2 2
switch reg w 14 405555
switch reg w 50 2001
switch reg w 98 7f3f
switch reg w e4 3f
#WLLLL
#switch reg w 40 1002
#switch reg w 44 1001
#switch reg w 48 1001
#switch reg w 70 ffff417e
#LLLLW
switch reg w 40 1001
switch reg w 44 1001
switch reg w 48 1002
switch reg w 70 ffff506f


/bin/udp_mount &
/bin/storage.sh mount
sleep 1 



/bin/mount -t sysfs none /sys
echo "/bin/igd_hotplug" > /proc/sys/kernel/hotplug

/bin/logd &

/bin/region.sh
# ap or aprouter
/web/cgi-bin/cgitest.cgi ap_apr & 

/bin/init.sh ralink all

# start web server
webs&
timer&
ralink_reset
/usr/sbin/telnetd
/bin/web_hard &

/bin/storage.sh webhard

echo "#!/bin/sh" > /var/ppp/true
chmod 755 /var/ppp/true

# daemon to monitor reload default and disable RF
#reload&

#add port trigger
/web/cgi-bin/cgitest.cgi port_trigger &

#add ftp port
/web/cgi-bin/cgitest.cgi ftp_port &

#add superdmz
#/bin/superdmz_init.sh

#net sniffer
/web/cgi-bin/cgitest.cgi net_sniffer &



/bin/cdrom_wizard &



echo 2048 > /proc/sys/net/ipv4/route/max_size
echo 180 > /proc/sys/net/ipv4/route/gc_thresh
echo 1 > /proc/sys/net/ipv4/route/gc_elasticity
echo 35 > /proc/sys/net/ipv4/route/gc_interval
echo 10 > /proc/sys/net/ipv4/route/gc_timeout
# NW725-4096 NW715-2048 NW705-1024
#echo "1024" > /proc/sys/net/netfilter/nf_conntrack_max
echo "2048" > /proc/sys/net/netfilter/nf_conntrack_max
echo "420" > /proc/sys/net/netfilter/nf_conntrack_tcp_timeout_established
#echo "60" > /proc/sys/net/ipv4/netfilter/nf_conntrack_udp_timeout
echo "5" > /proc/sys/net/netfilter/nf_conntrack_tcp_timeout_time_wait
echo "5" > /proc/sys/net/netfilter/nf_conntrack_tcp_timeout_close
echo "90" > /proc/sys/net/netfilter/nf_conntrack_udp_timeout_stream
echo "90" > /proc/sys/net/netfilter/nf_conntrack_generic_timeout
echo 2048 > /proc/sys/net/core/hot_list_length



/bin/get_mac_from_pc.sh &
#echo 60 > /proc/sys/net/core/netdev_budget
#echo 300 > /proc/sys/net/core/netdev_max_backlog

